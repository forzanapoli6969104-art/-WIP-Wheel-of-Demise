{
  "name": "ruota-della-sfortuna",
  "version": "1.1.0",
  "description": "Ruota della fortuna personalizzabile",
  "main": "main.js",
  "author": "Ruota della Sfortuna",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.ruotadellasfortuna.app",
    "productName": "Ruota della Sfortuna",
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "favicon.svg",
      "icon.png",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "icon.png"
    }
  }
}
